# Ghostline backend — every setting, empty. Never commit a filled copy.
GHOSTLINE_ENV=staging                      # staging | prod | test
DATABASE_URL=                              # postgresql://ghostline:<password>@homelab-postgres:5432/ghostline_staging_db
GHOSTLINE_DB_POOL_MAX=3                    # api 3, worker 2 (the role is capped at 10 for both environments together)
GHOSTLINE_MIGRATIONS=                      # default: backend/migrations (the image sets /app/backend/migrations)
GHOSTLINE_SESSION_SECRET=                  # signs session tokens (Vaultwarden ghostline-session-secret)
GHOSTLINE_SESSION_DAYS=30
GHOSTLINE_OWNER_APPLE_ID=                  # the one Apple ID email (or Apple user id) that may sign in; empty = nobody
GHOSTLINE_APPLE_AUDIENCE=com.wavetech.ghostline
GHOSTLINE_WORKER_TOKEN=                    # the worker's credential for the api's internal routes (never the owner's)
GHOSTLINE_TEST_SIGNER_KEY=                 # CI and tests only: accepts tokens from the test signer; never set in production
GHOSTLINE_API_INTERNAL_URL=                # http://coolify-ghostline-api-staging:8000 (the worker calls the api here)

MINIO_ENDPOINT=                            # http://homelab-minio:9000
MINIO_BUCKET=                              # ghostline-staging | ghostline-prod (private)
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

APNS_ENABLED=false                         # true in production only
APNS_KEY_ID=                               # 672L2NUD7M
APNS_TEAM_ID=                              # WLL7D7F26Q
APNS_KEY_P8=                               # base64 of the .p8
APNS_TOPIC=com.wavetech.ghostline

CLAUDE_CODE_OAUTH_TOKEN=                   # worker only: headless `claude -p` on the subscription; no ANTHROPIC_* here
