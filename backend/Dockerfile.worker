# Ghostline worker: the api's image with its own start command (Coolify builds it as a second application from the
# same repository; the two Dockerfiles stay line for line the same except the CMD).
FROM python:3.12-slim AS base

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

# Claude runs here as headless `claude -p` on the subscription token (the CLI is the only path that can use it):
# Node 22 and the CLI, pinned as the homelab runtime pins them. No ANTHROPIC_* key ever enters this image.
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates gnupg     && curl -fsSL https://deb.nodesource.com/setup_22.x | bash -     && apt-get install -y --no-install-recommends nodejs     && npm install -g @anthropic-ai/claude-code@2.1.281     && npm cache clean --force     && apt-get purge -y gnupg && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*     && claude --version

COPY VERSION /app/VERSION
COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir -r /app/backend/requirements.txt

COPY backend/pyproject.toml backend/README.md /app/backend/
COPY backend/ghostline /app/backend/ghostline
COPY backend/migrations /app/backend/migrations
RUN pip install --no-cache-dir --no-deps /app/backend

# Coolify passes the commit it builds as the build arg SOURCE_COMMIT (its build context carries no .git).
ARG SOURCE_COMMIT=unknown
RUN printf '%s' "$SOURCE_COMMIT" > /app/COMMIT && echo "commit: $SOURCE_COMMIT"
ENV GHOSTLINE_COMMIT=$SOURCE_COMMIT \
    GHOSTLINE_COMMIT_FILE=/app/COMMIT \
    GHOSTLINE_VERSION_FILE=/app/VERSION \
    GHOSTLINE_MIGRATIONS=/app/backend/migrations
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health')"

CMD ["python", "-m", "ghostline.worker"]
